.dialog { width: min(660px, calc(100vw - 30px)); max-height: calc(100vh - 34px); overflow: auto; border: 1px solid var(--line); border-radius: 20px; padding: 0; color: var(--ink); background: var(--surface); box-shadow: 0 24px 80px rgba(16,35,31,.25); }
