  .clip-analysis-panel .analysis-block + .analysis-block { border-top: 0; border-left: 1px solid var(--line); }
  .role-review-grid { grid-template-columns: 1fr 1fr 1fr; }
  .rights-grid { grid-template-columns: 1fr; }
  .local-rag-form { grid-template-columns: 170px 1fr; }
  .rag-form-actions { grid-column: 1 / -1; grid-template-columns: 1fr auto; }
}

@media (max-width: 760px) {
  .app-shell { display: block; }
  .sidebar { transform: translateX(-100%); transition: transform .22s ease; box-shadow: 20px 0 50px rgba(0,0,0,.2); }
  body.sidebar-open .sidebar { transform: translateX(0); }
  .main { min-width: 0; }
  .mobile-menu { display: block; }
  .topbar { height: 76px; padding: 0 14px; gap: 8px; }
  .top-actions .button-quiet { display: none; }
  .top-actions .button-primary { width: 44px; overflow: hidden; color: transparent; padding: 0; position: relative; }
  .top-actions .button-primary::after { content: "+"; color: white; position: absolute; inset: 0; display: grid; place-items: center; font-size: 20px; }
  .avatar { display: none; }
  .subject-title p { max-width: 48vw; }
  .tabs { top: 76px; padding: 0 16px; gap: 20px; }
  .content { padding: 26px 16px 55px; }
  .welcome-row, .section-heading { align-items: flex-start; }
  .updated-label, .canonical-badge, .draft-banner { display: none; }
  .overview-grid, .dossier-layout, .split-layout, .observation-layout, .handoff-grid { grid-template-columns: 1fr; }
  .profile-glance, .recent-card, .identity-card, .dossier-section.full { grid-column: auto; }
  .stat-card { min-height: 105px; }
  .identity-card dl { grid-template-columns: 1fr 1fr; }
  .timeline-item { grid-template-columns: 1fr; gap: 12px; }
  .timeline-meta { border-right: 0; border-bottom: 1px solid #e6e3d9; padding-bottom: 10px; }
  .observation-pair, .boundary-grid { grid-template-columns: 1fr; }
  .local-rag-head { display: grid; }
  .local-rag-form { grid-template-columns: 1fr; }
  .rag-form-actions { grid-column: auto; grid-template-columns: 1fr; }
  .rag-video-results article { align-items: flex-start; flex-direction: column; }
  .rights-summary { grid-template-columns: 1fr; }
  .child-stop-button { min-height: 44px; max-width: 112px; padding: 0 10px; font-size: 11px; }
  .pattern-promotion-form, .pattern-suppression-form { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
  .camera-stage form { grid-template-columns: 1fr; }
  .camera-stage form .button { grid-column: auto; }
  .sensing-metrics { grid-template-columns: 1fr 1fr; }
  .clip-review-heading { align-items: flex-start; }
  .clip-review-heading .button { width: 100%; }
  .integration-strip { align-items: flex-start; flex-wrap: wrap; gap: 12px 20px; }
  .integration-strip > p { width: 100%; margin-left: 0; }
  .clip-review-grid { grid-template-columns: 1fr; }
  .clip-list { max-height: 240px; }
  .clip-analysis-panel { grid-column: auto; grid-template-columns: 1fr; }
  .clip-analysis-panel .analysis-block + .analysis-block { border-top: 1px solid var(--line); border-left: 0; }
  .cross-review-head, .review-submit-row { align-items: stretch; flex-direction: column; }
  .role-review-grid, .review-form-grid { grid-template-columns: 1fr; }
  .review-submit-row .button { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .001ms !important; transition-duration: .001ms !important; }
}
