.clip-review-grid { display: grid; grid-template-columns: minmax(190px,.56fr) minmax(330px,1.08fr) minmax(310px,.95fr); gap: 12px; align-items: start; }
.clip-list-panel, .clip-player-panel, .clip-analysis-panel { overflow: hidden; }
